rules_version = '2';

// =====================================================================
// 在地文化知識型互動平台 — Firestore 安全規則（GitHub 遷移版）
//
// 內容資料（Banner／任務／公告／徽章／證書字典／頭像清單）已搬到 GitHub，
// 不再存於 Firestore，因此本檔案不再有這些 collection 的規則。
//
// 金幣防作弊機制也跟著調整：因為任務的 entryCost／dailyRewardCap 已經
// 不在 Firestore，規則無法再逐筆核對交易金額是否正確，改用「每人每日
// 總量防護」（dailyGuard）——不管單筆金額多少，只要今天累計的淨變動量
// 或交易次數超過上限就擋下來。這是刻意的取捨，詳見「架構調整討論記錄.md」
// 第三輪確認的風險評估。
//
// ⚠️ 部署前請務必先用 Firebase Local Emulator Suite（firebase emulators:start）
// 搭配測試資料驗證這份規則。
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===================================================================
    // dailyGuard／單筆上限相關參數（調整數值只要改這裡，其他地方都是引用）
    // ===================================================================

    function DAILY_CAP() { return 300; }        // 每人每日金幣淨變動上限
    function MAX_TX_PER_DAY() { return 800; }    // 每人每日交易次數上限
    function MAX_SINGLE_TX() { return 50; }      // 任務單筆金幣異動（獎勵/扣款）上限，不適用於商店兌換
    function MAX_SHOP_ITEM_COST() { return 300; } // 商店單次兌換上限，跟 MAX_SINGLE_TX 分開算，
                                                    // 因為兌換價格是後台自訂的合法金額，不是任務頁面片面宣稱的數字

    // ===================================================================
    // 共用工具函式
    // ===================================================================

    function validTicketId(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,80}$'); }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 以 UTC+8（台灣時區）為準，計算「今天是第幾天」的整數（epoch day）
    function utc8DayNumber() {
      return int((request.time.toMillis() + 8 * 60 * 60 * 1000) / (24 * 60 * 60 * 1000));
    }

    function changedKeys(before, after) {
      return after.diff(before).affectedKeys();
    }

    // ===================================================================
    // 使用者名稱唯一性：usernames/{username小寫}
    // ===================================================================

    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin(); // 供後台「刪除玩家」功能釋出使用者名稱用
    }

    // ===================================================================
    // 管理者白名單：僅本人可讀自己的白名單狀態，任何人不可寫
    // （內容資料維護已改走 GitHub API，這裡的管理者權限現在只用於
    //  「編修使用者資料」這一項，見 8.3 節精神延續）
    // ===================================================================

    match /admins/{adminUid} {
      allow read: if isOwner(adminUid);
      allow write: if false;
    }

    // ===================================================================
    // 使用者資料：users/{uid}
    // ===================================================================

    match /users/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && request.resource.data.level == 1
        && request.resource.data.coins == 0
        && request.resource.data.badges == []
        && request.resource.data.certificates == []
        && request.resource.data.get('itemTickets', []) == []
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.nickname.matches('^[A-Za-z0-9\u4e00-\u9fa5]+$');

      // 管理者：可自由編修任何使用者資料（金幣調整等人工修正用途）
      allow update: if isAdmin();

      allow delete: if isAdmin(); // 供後台「刪除玩家」功能使用

      // 一般使用者：僅限本人，且只能是下列其中一種「合法異動樣式」
      allow update: if isOwner(uid) && isAllowedUserEdit(resource.data, request.resource.data);

      // 依交易類型進入對應驗證，避免錯誤格式觸發其他分支的欄位讀取及運算上限。
      function isAllowedUserEdit(before, after) {
        let type = after.get('lastTransaction', {}).get('type', '');
        return isProfileOnlyEdit(before, after) ? true
          : type == 'daily_login' ? isDailyLoginClaim(before, after)
          : type == 'task_cost' ? isTaskCostDeduction(before, after)
          : type == 'task_reward' ? isTaskRewardClaim(before, after)
          : type == 'collectible_award' ? isCollectibleClaim(before, after)
          : type == 'merchant_purchase' ? isMerchantPurchase(before, after)
          : type == 'shop_redemption' ? isShopRedemption(before, after)
          : type == 'item_ticket_purchase' ? isItemTicketPurchase(before, after)
          : type == 'item_ticket_use' ? isItemTicketUse(before, after)
          : false;
      }

      // --- 樣式 1：只改暱稱／頭像／公告已讀時間，不動金幣與 dailyGuard ---
      function isProfileOnlyEdit(before, after) {
        return changedKeys(before, after).hasOnly(['nickname', 'avatarId', 'lastNewsViewedAt'])
          && (!('nickname' in after) || (
            after.nickname is string
            && after.nickname.size() >= 1
            && after.nickname.size() <= 20
            && after.nickname.matches('^[A-Za-z0-9\u4e00-\u9fa5]+$')
          ));
      }

      // --- 每日總量防護核心邏輯：驗證 dailyGuard 是否正確地反映了這次異動 ---
      // netDelta：這次異動造成 coins 的淨變化量（登入/獎勵為正，扣款為負，
      //           徽章證書核發等非金幣異動傳 0）
      function isValidDailyGuardUpdate(before, after, netDelta) {
        let today = utc8DayNumber();
        let prevGuard = before.get('dailyGuard', null);
        let isNewDay = prevGuard == null || prevGuard.day != today;
        let prevNet = isNewDay ? 0 : prevGuard.netChange;
        let prevTx = isNewDay ? 0 : prevGuard.txCount;
        let g = after.dailyGuard;

        return g.day == today
          && g.netChange == prevNet + netDelta
          && g.txCount == prevTx + 1
          && g.netChange <= DAILY_CAP()
          && g.txCount <= MAX_TX_PER_DAY();
      }

      // --- 樣式 2：每日登入獎勵（拉霸），同一自然日（UTC+8）只能領一次 ---
      // 金額不再固定 +10：改成每日拉霸抽出的數字，允許 1 ~ MAX_SINGLE_TX() 的整數。
      // 上限實際上由後台 data/settings.json 的 dailyLoginCoins 決定（規則讀不到 GitHub
      // 上的設定檔，所以這裡只能擋住 1~50 這個外框）；金幣增加量、交易紀錄的金額、
      // 每日防護的淨變動三者必須是同一個數字，不能各寫各的。
      function isDailyLoginClaim(before, after) {
        let today = utc8DayNumber();
        let amount = after.lastTransaction.amount;
        return before.get('lastDailyLoginDay', -1) != today
          && after.lastDailyLoginDay == today
          && amount is int
          && amount >= 1
          && amount <= MAX_SINGLE_TX()
          && after.coins == before.coins + amount
          && changedKeys(before, after).hasOnly(['lastDailyLoginDay', 'coins', 'dailyGuard', 'lastTransaction'])
          && after.lastTransaction.type == 'daily_login'
          && isValidDailyGuardUpdate(before, after, amount);
      }

      // --- 樣式 3：進入任務扣款。因任務資料不在 Firestore，無法核對金額
      //     是否等於任務真實設定的 entryCost，只驗證餘額不會變負數，
      //     並受 dailyGuard 總量防護限制 ---
      function isTaskCostDeduction(before, after) {
        let tx = after.lastTransaction;
        let cost = before.coins - after.coins;
        return tx.type == 'task_cost'
          && cost > 0
          && cost <= MAX_SINGLE_TX()
          && after.coins >= 0
          && tx.amount == cost
          && changedKeys(before, after).hasOnly(['coins', 'dailyGuard', 'lastTransaction'])
          && isValidDailyGuardUpdate(before, after, -cost);
      }

      // --- 樣式 4：任務獎勵。同樣因任務資料不在 Firestore，
      //     不再核對個別任務的每日上限，改受全域 dailyGuard 限制 ---
      function isTaskRewardClaim(before, after) {
        let tx = after.lastTransaction;
        let amount = after.coins - before.coins;
        return tx.type == 'task_reward'
          && amount > 0
          && amount <= MAX_SINGLE_TX()
          && tx.amount == amount
          && changedKeys(before, after).hasOnly(['coins', 'dailyGuard', 'lastTransaction'])
          && isValidDailyGuardUpdate(before, after, amount);
      }

      // --- 樣式 5：任務授予的徽章／證書。不再核對來源任務是否正確
      //     （字典已搬到 GitHub，無法核對），僅受 dailyGuard 交易次數限制 ---
      function isCollectibleClaim(before, after) {
        let tx = after.lastTransaction;
        let changedBadges = changedKeys(before, after).hasOnly(['badges', 'dailyGuard', 'lastTransaction'])
          && after.badges.size() == before.badges.size() + 1;
        let changedCerts = changedKeys(before, after).hasOnly(['certificates', 'dailyGuard', 'lastTransaction'])
          && after.certificates.size() == before.certificates.size() + 1;
        return tx.type == 'collectible_award'
          && (changedBadges || changedCerts)
          && isValidDailyGuardUpdate(before, after, 0);
      }
      // 通用道具券流程：目錄由後台管理，規則只驗證扣款、持有上限與消耗。
      function isItemTicketPurchase(before, after) {
        let tx = after.lastTransaction;
        let oldTickets = before.get('itemTickets', []);
        let receiptPath = /databases/$(database)/documents/shopRedemptions/$(uid)/entries/$(tx.requestId);
        return tx.type == 'item_ticket_purchase'
          && validTicketId(tx.itemId)
          && tx.amount is int && tx.amount > 0 && tx.amount <= MAX_SHOP_ITEM_COST()
          && tx.requestId is string
          && tx.requestId.matches('^[A-Za-z0-9_-]{1,80}$')
          && !(tx.itemId in oldTickets)
          && after.itemTickets == oldTickets.concat([tx.itemId])
          && after.coins == before.coins - tx.amount && after.coins >= 0
          && changedKeys(before, after).hasOnly(['coins', 'itemTickets', 'dailyGuard', 'lastTransaction'])
          && isValidDailyGuardUpdate(before, after, -tx.amount)
          && !exists(receiptPath)
          && getAfter(receiptPath).data.itemId == tx.itemId
          && getAfter(receiptPath).data.type == 'item_ticket'
          && getAfter(receiptPath).data.cost == tx.amount;
      }
      function isItemTicketUse(before, after) {
        let tx = after.lastTransaction;
        let oldTickets = before.get('itemTickets', []);
        let usagePath = /databases/$(database)/documents/itemTicketUses/$(uid)/entries/$(tx.requestId);
        return tx.type == 'item_ticket_use'
          && validTicketId(tx.itemId) && validTicketId(tx.taskId)
          && tx.requestId is string && tx.requestId.matches('^[A-Za-z0-9_-]{1,80}$')
          && tx.itemId in oldTickets
          && after.itemTickets == oldTickets.removeAll([tx.itemId])
          && after.coins == before.coins
          && changedKeys(before, after).hasOnly(['itemTickets', 'dailyGuard', 'lastTransaction'])
          && isValidDailyGuardUpdate(before, after, 0)
          && !exists(usagePath)
          && getAfter(usagePath).data.itemId == tx.itemId
          && getAfter(usagePath).data.taskId == tx.taskId
          && getAfter(usagePath).data.requestId == tx.requestId;
      }

      // --- 樣式 6：商店兌換扣款。商品目錄跟任務一樣不在 Firestore（放 GitHub），
      //     規則無法核對兌換的品項是否真的存在、金額是否正確，只能限制單筆金額上限
      //     （跟任務用不同的上限 MAX_SHOP_ITEM_COST，因為商店價格是後台自訂的合法金額，
      //     不是任務頁面片面宣稱的數字），並受 dailyGuard 總量防護限制 ---
      function isMerchantPurchase(before, after) {
        let tx = after.lastTransaction;
        let receiptPath = /databases/$(database)/documents/shopRedemptions/$(uid)/entries/$(tx.requestId);
        return tx.amount is int && tx.amount > 0 && tx.amount <= MAX_SHOP_ITEM_COST()
          && validTicketId(tx.itemId) && validTicketId(tx.requestId)
          && after.coins == before.coins - tx.amount && after.coins >= 0
          && changedKeys(before, after).hasOnly(['coins', 'dailyGuard', 'lastTransaction'])
          && isValidDailyGuardUpdate(before, after, -tx.amount)
          && !exists(receiptPath)
          && getAfter(receiptPath).data.type == 'merchant_coupon'
          && getAfter(receiptPath).data.itemId == tx.itemId
          && getAfter(receiptPath).data.cost == tx.amount;
      }

      function isShopRedemption(before, after) {
        let tx = after.lastTransaction;
        let cost = before.coins - after.coins;
        return tx.type == 'shop_redemption'
          && cost > 0
          && cost <= MAX_SHOP_ITEM_COST()
          && after.coins >= 0
          && tx.amount == cost
          && changedKeys(before, after).hasOnly(['coins', 'dailyGuard', 'lastTransaction'])
          && isValidDailyGuardUpdate(before, after, -cost);
      }
    }

    // ===================================================================
    // 通行金幣收支明細：唯讀帳本，只能新增、不能修改或刪除
    // ===================================================================

    match /coinLedger/{uid}/entries/{entryId} {
      allow read: if isOwner(uid) || isAdmin();

      // ⚠️ 原本這裡有一條 request.resource.data.balanceAfter ==
      //    getAfter(.../users/$(uid)).data.coins，跨文件比對「交易後的使用者餘額」。
      //    這是整份規則裡唯一一個依賴 getAfter() 的地方，而 Firestore 交易是「一份
      //    文件沒過規則、整筆交易全部回滾」，一旦 getAfter() 判斷有任何差池（例如
      //    交易內部讀寫時序、型別轉換的細微差異），連帶讓「使用者文件本身其實完全
      //    合規」的金幣異動也一起被拒絕，且只會回報通用的 permission-denied，事後
      //    完全查不出真正卡在哪一步。拿掉之後，balanceAfter 純粹變成「當下呼叫端
      //    自己算出來寫入」的參考欄位，不再由規則驗證是否等於使用者文件的真實餘額
      //    ——這個記帳本本來就只是給玩家自己查詢消費紀錄用的參考資料，不是遊戲
      //    金幣餘額本身的把關機制（真正管控金幣的是 users 文件自己的規則），
      //    balanceAfter 就算被竄改成假數字，也不會讓玩家真的拿到不該有的金幣。
      allow create: if (isOwner(uid) || isAdmin())
        && request.resource.data.type in ['daily_login', 'task_cost', 'task_reward', 'shop_redemption', 'admin_adjust']
        && (request.resource.data.type != 'admin_adjust' || isAdmin())
        && request.resource.data.amount is number
        && request.resource.data.balanceAfter is number;

      allow update: if false;
      allow delete: if isAdmin(); // 供後台「刪除玩家」功能清空明細用
    }

    // ===================================================================
    // 排行榜：leaderboard/{taskId}/entries/{uid}
    // ===================================================================

    match /leaderboard/{taskId}/entries/{entryUid} {
      allow read: if true;

      // 玩家本人寫入時，playerName 要符合跟暱稱一致的格式驗證，避免有人繞過網頁介面
      // 直接呼叫 API 塞入任意內容（例如惡意 HTML），這個排行榜是公開可讀的頁面。
      function isValidPlayerName(name) {
        return name is string
          && name.size() >= 1
          && name.size() <= 20
          && name.matches('^[A-Za-z0-9\u4e00-\u9fa5]+$');
      }

      allow create: if (isOwner(entryUid)
          && request.resource.data.scoreValue is number
          && isValidPlayerName(request.resource.data.playerName)
          && request.resource.data.scoreLabel is string
          && request.resource.data.scoreLabel.size() <= 40)
        || isAdmin();

      // 玩家本人只能覆寫成「更高分」；admin 可以改成任意分數（人工修正錯誤/作弊用）
      allow update: if (isOwner(entryUid)
          && request.resource.data.scoreValue is number
          && request.resource.data.scoreValue > resource.data.scoreValue
          && isValidPlayerName(request.resource.data.playerName)
          && request.resource.data.scoreLabel is string
          && request.resource.data.scoreLabel.size() <= 40)
        || (isAdmin() && request.resource.data.scoreValue is number);

      allow delete: if isAdmin();
    }

    // ===================================================================
    // 排行榜快照：leaderboardSummary/{taskId}（單一文件，取代逐筆查詢前10名）
    // 這份資料是「衍生快取」，不是權威資料來源——真正算分/發獎勵都是看上面
    // leaderboard/{taskId}/entries/{uid} 這份逐筆資料，這份快照只是给「查看排行榜」
    // 這個顯示用途省掉每次 10 次讀取的查詢，就算裡面資料一時不夠精準，下一次有人
    // 破紀錄時就會自然被覆寫更新，風險有限，所以不用像上面那份逐筆資料一樣嚴格
    // 驗證每一筆內容，只要求基本的結構合理（陣列、最多10筆）。
    // ===================================================================
    match /leaderboardSummary/{taskId} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 10;
      allow delete: if isAdmin();
    }

    // ===================================================================
    // 商店兌換紀錄：shopRedemptions/{uid}/entries/{entryId}
    // 玩家兌換商品時的紀錄快照（品項名稱、花費、時間），核銷流程是玩家把這筆紀錄的畫面
    // 新店家商品保存獨立券號並以連線交易核銷；舊收據保持原樣，
    // 只能新增、不能改或刪，避免有人事後竄改兌換紀錄的內容或花費金額。
    // ===================================================================

    match /itemTicketUses/{uid}/entries/{entryId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['itemId', 'taskId', 'requestId', 'usedAt'])
        && validTicketId(request.resource.data.itemId)
        && validTicketId(request.resource.data.taskId)
        && request.resource.data.requestId == entryId
        && entryId.matches('^[A-Za-z0-9_-]{1,80}$')
        && request.resource.data.usedAt is number
        && request.resource.data.itemId in get(/databases/$(database)/documents/users/$(uid)).data.get('itemTickets', [])
        && !(request.resource.data.itemId in getAfter(/databases/$(database)/documents/users/$(uid)).data.itemTickets)
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastTransaction.type == 'item_ticket_use'
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastTransaction.itemId == request.resource.data.itemId
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastTransaction.taskId == request.resource.data.taskId
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastTransaction.requestId == entryId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /shopRedemptions/{uid}/entries/{entryId} {
      allow read: if isOwner(uid) || isAdmin();

      function validMerchantCoupon() {
        let c = request.resource.data;
        let userPath = /databases/$(database)/documents/users/$(uid);
        let before = get(userPath).data;
        let after = getAfter(userPath).data;
        return c.keys().hasOnly(['type', 'itemId', 'itemName', 'description', 'iconUrl', 'cost',
            'couponCode', 'redeemedAt', 'issuedAt', 'validUntil', 'expiresAt', 'status', 'usedAt'])
          && validTicketId(c.itemId) && c.itemName is string && c.itemName.size() <= 60
          && c.description is string && c.description.size() <= 10000
          && c.iconUrl is string && c.iconUrl.size() <= 2048
          && c.couponCode is string && c.couponCode.matches('^[A-Z0-9]{12}$')
          && c.cost is int && c.cost > 0 && c.cost <= MAX_SHOP_ITEM_COST()
          && c.redeemedAt is number && c.issuedAt == request.time
          && c.status == 'available' && c.usedAt == null
          && c.validUntil is string
          && ((c.validUntil == '' && c.expiresAt == null)
            || (c.validUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && c.expiresAt is int && c.expiresAt > request.time.toMillis()))
          && after.lastTransaction.type == 'merchant_purchase'
          && after.lastTransaction.requestId == entryId
          && after.lastTransaction.itemId == c.itemId && after.lastTransaction.amount == c.cost
          && after.coins == before.coins - c.cost;
      }
      allow create: if isOwner(uid) && request.resource.data.get('type', '') == 'merchant_coupon'
        && validMerchantCoupon();

      allow create: if (isOwner(uid) || isAdmin())
        && request.resource.data.get('type', '') != 'merchant_coupon'
        && request.resource.data.itemId is string
        && request.resource.data.itemName is string
        && request.resource.data.itemName.size() <= 60
        && request.resource.data.cost is number
        && request.resource.data.cost > 0
        && request.resource.data.cost <= MAX_SHOP_ITEM_COST()
        && request.resource.data.redeemedAt is number
        && (isAdmin() || request.resource.data.get('type', 'merchant') != 'item_ticket' || (
          validTicketId(request.resource.data.itemId)
          && request.resource.data.cost is int
          && request.resource.data.cost == getAfter(/databases/$(database)/documents/users/$(uid)).data.lastTransaction.amount
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastTransaction.type == 'item_ticket_purchase'
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastTransaction.requestId == entryId
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastTransaction.itemId == request.resource.data.itemId
          && !(request.resource.data.itemId in get(/databases/$(database)/documents/users/$(uid)).data.get('itemTickets', []))
          && request.resource.data.itemId in getAfter(/databases/$(database)/documents/users/$(uid)).data.itemTickets
        ));

      allow update: if isOwner(uid)
        && resource.data.get('type', '') == 'merchant_coupon'
        && resource.data.status == 'available'
        && request.resource.data.status == 'used'
        && request.resource.data.usedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt'])
        && (resource.data.expiresAt == null || request.time.toMillis() < resource.data.expiresAt);
      // 清除失效券只更新原券狀態，不新增紀錄，不刪除券。
      allow update: if isOwner(uid)
        && resource.data.get('type', '') == 'merchant_coupon'
        && (resource.data.status == 'used'
          || (resource.data.status == 'available' && resource.data.expiresAt != null
            && request.time.toMillis() >= resource.data.expiresAt))
        && request.resource.data.status == 'cleared'
        && request.resource.data.clearedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'clearedAt']);
      allow delete: if isAdmin(); // 供後台「刪除玩家」功能清空兌換紀錄用
    }

    // ===================================================================
    // 任務事件記錄：taskEventLogs/{logId}
    // 平台處理任務頁面送來的 complete/score 等訊息時，把關鍵結果（成功/被拒絕/
    // 例外/訊息被忽略）寫下來，方便事後在後台查，不用即時盯著 console 看。
    // 只能新增、不能改或刪，是唯讀事後稽核用的記錄，不是給玩家自己查看的資料。
    // ===================================================================

    match /taskEventLogs/{logId} {
      allow read: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.level in ['info', 'warn', 'error']
        && request.resource.data.at is number;

      // 一般情況下這是唯讀稽核記錄、玩家自己不能刪也不能改；只有管理者可以刪，
      // 對應後台「系統記錄」分頁的清除功能，用來定期清空這份純診斷用途的記錄，
      // 不是給玩家自己清除自己的記錄。
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===================================================================
    // 現場競賽即時看板：liveCompetition/{slotId}
    // 完全獨立於平台正式資料之外的臨時性資料表，只給「魚丸追追樂現場5人競賽」
    // 這個活動限定工具使用（catch-event.html + catch-event-board.html）。
    // 不驗證身分（平板不登入平台帳號，只認機器編號 slot1~slot5），公開可讀寫，
    // 不涉及任何真實玩家帳號/金幣/徽章/排行榜資料，活動結束後這份資料放著
    // 不管也不影響任何其他功能。
    // ===================================================================
    match /liveCompetition/{slotId} {
      allow read, write: if true;
    }

    // ===== Fishball race V2: new namespace only; legacy rules above unchanged =====
    function fbRaceMaxScore(a,b) { return a > b ? a : b; }
    function fbRaceLive(roundId) {
      let control = get(/databases/$(database)/documents/fishballRaceControl/current).data;
      let round = get(/databases/$(database)/documents/fishballRaceRounds/$(roundId)).data;
      return control.roundId == roundId && control.status == 'running'
        && request.time >= round.startedAt
        && request.time < round.startedAt + duration.value(round.duration, 's');
    }
    function fbRaceValidRound(d,roundId) {
      return d.keys().hasAll(['roundId','status','startedAt','duration','hostUid'])
        && d.keys().hasOnly(['roundId','status','startedAt','duration','hostUid'])
        && d.roundId == roundId && d.roundId is string && d.roundId.size() == 36
        && d.status == 'running' && d.hostUid is string && d.hostUid.size() == 36
        && d.startedAt == request.time
        && d.duration is int && d.duration >= 10 && d.duration <= 10800;
    }
    function fbRaceValidStop(d,old) {
      return old.status == 'running'
        && request.time < old.startedAt + duration.value(old.duration,'s')
        && d.keys().hasAll(['roundId','status','startedAt','duration','hostUid','stoppedAt','stoppedBy'])
        && d.keys().hasOnly(['roundId','status','startedAt','duration','hostUid','stoppedAt','stoppedBy'])
        && d.diff(old).affectedKeys().hasOnly(['status','stoppedAt','stoppedBy'])
        && d.status == 'stopped' && d.stoppedAt == request.time
        && d.stoppedBy is string && d.stoppedBy.size() == 36;
    }
    function fbRaceValidPlayer(d) {
      return d.keys().hasAll(['deviceId','name','currentScore','completedBestScore','bestScore','attempt','phase','level','updatedAt'])
        && d.keys().hasOnly(['deviceId','name','currentScore','completedBestScore','bestScore','attempt','phase','level','updatedAt'])
        && d.deviceId is string && d.deviceId.size() == 36
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.currentScore is int && d.currentScore >= -100000 && d.currentScore <= 1000000
        && d.completedBestScore is int && d.completedBestScore >= -100000 && d.completedBestScore <= 1000000
        && d.bestScore == fbRaceMaxScore(d.completedBestScore,d.currentScore)
        && d.attempt is int && d.attempt >= 1
        && d.phase in ['playing','finished']
        && d.level is int && d.level >= 1 && d.level <= 10
        && d.updatedAt == request.time;
    }
    function fbRaceValidUpdate(d,old) {
      return d.deviceId == old.deviceId && d.name == old.name
        && (
          (d.attempt == old.attempt && old.phase == 'playing'
            && d.level >= old.level
            && d.completedBestScore == (d.phase == 'finished' ? fbRaceMaxScore(old.completedBestScore,d.currentScore) : old.completedBestScore))
          || (d.attempt == old.attempt + 1 && d.phase == 'playing' && d.currentScore == 0 && d.level == 1
            && d.completedBestScore == fbRaceMaxScore(old.completedBestScore,old.currentScore))
        );
    }
    match /fishballRaceClocks/{uid} {
      allow get: if true;
      allow create, update: if uid.size() == 36
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
      allow list, delete: if false;
    }
    match /fishballRaceControl/current {
      allow read: if true;
      allow create, update: if (
        (request.resource.data.keys().hasAll(['roundId','status','startedAt','duration','hostUid'])
          && request.resource.data.keys().hasOnly(['roundId','status','startedAt','duration','hostUid'])
          && request.resource.data.roundId == null && request.resource.data.status == 'ready'
          && request.resource.data.startedAt == null && request.resource.data.duration == 0
          && request.resource.data.hostUid is string && request.resource.data.hostUid.size() == 36)
        || (exists(/databases/$(database)/documents/fishballRaceControl/current)
          && fbRaceValidStop(request.resource.data,resource.data))
        || (fbRaceValidRound(request.resource.data,request.resource.data.roundId)
          && getAfter(/databases/$(database)/documents/fishballRaceRounds/$(request.resource.data.roundId)).data == request.resource.data
          && (!exists(/databases/$(database)/documents/fishballRaceControl/current)
            || resource.data.status in ['ready','stopped']
            || request.time >= resource.data.startedAt + duration.value(resource.data.duration,'s')))
      );
      allow delete: if false;
    }
    match /fishballRaceRounds/{roundId} {
      allow read: if true;
      allow create: if fbRaceValidRound(request.resource.data,roundId)
        && getAfter(/databases/$(database)/documents/fishballRaceControl/current).data.roundId == roundId;
      allow update, delete: if false;
      match /players/{playerId} {
        allow read: if true;
        allow create: if playerId.size() == 36 && fbRaceLive(roundId)
          && fbRaceValidPlayer(request.resource.data)
          && request.resource.data.attempt == 1 && request.resource.data.phase == 'playing'
          && request.resource.data.currentScore == 0 && request.resource.data.bestScore == 0
          && request.resource.data.completedBestScore == -100000 && request.resource.data.level == 1;
        allow update: if fbRaceLive(roundId)
          && fbRaceValidPlayer(request.resource.data) && fbRaceValidUpdate(request.resource.data,resource.data);
        allow delete: if false;
      }
    }
  }
}
